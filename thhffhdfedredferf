function Library:Notify(config)
	local title = config.Title or "Notification"
	local text = config.Content or "Description here"
	local duration = config.Duration or 3

	local Notif = Create("Frame", {
		Size = UDim2.new(1, 40, 0, 65), BackgroundColor3 = Theme.Background,
		BackgroundTransparency = 0.1, Parent = NotifContainer, ClipsDescendants = true
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Notif})
	Create("UIStroke", {Color = Theme.Accent, Thickness = 1, Parent = Notif})

	Create("TextLabel", {
		Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 8),
		BackgroundTransparency = 1, Text = title, TextColor3 = Theme.Text,
		Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = Notif
	})
	Create("TextLabel", {
		Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 10, 0, 28),
		BackgroundTransparency = 1, Text = text, TextColor3 = Theme.SubText,
		Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = Notif
	})

	Tween(Notif, {Size = UDim2.new(1, 0, 0, 65)}, 0.4)
	task.delay(duration, function()
		Tween(Notif, {Size = UDim2.new(0, 0, 0, 65), BackgroundTransparency = 1}, 0.3).Completed:Wait()
		Notif:Destroy()
	end)
end

