function Library:LoadKeySystem(config)
	local KeySystem = {}
	local correctKey = config.Key
	local link = config.Link or "https://discord.gg/yourlink"

	local KeyWindow = Create("Frame", {
		Size = UDim2.new(0, 400, 0, 200), Position = UDim2.new(0.5, -200, 0.5, -100),
		BackgroundColor3 = Theme.Background, Parent = ScreenGui
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = KeyWindow})
	Create("UIStroke", {Color = Theme.Stroke, Parent = KeyWindow})
	MakeDraggable(KeyWindow, KeyWindow)

	Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, Text = config.Title or "Luxe Authentication",
		TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 18, Parent = KeyWindow
	})
	Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1,
		Text = "Please enter your license key to continue.", TextColor3 = Theme.SubText,
		Font = Enum.Font.Gotham, TextSize = 12, Parent = KeyWindow
	})

	local KeyBox = Create("TextBox", {
		Size = UDim2.new(1, -40, 0, 40), Position = UDim2.new(0, 20, 0, 75), BackgroundColor3 = Theme.Panel,
		Text = "", PlaceholderText = "Enter Key Here...", TextColor3 = Theme.Text,
		Font = Enum.Font.Gotham, TextSize = 14, Parent = KeyWindow
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = KeyBox})
	Create("UIStroke", {Color = Theme.Stroke, Parent = KeyBox})

	local CheckBtn = Create("TextButton", {
		Size = UDim2.new(0.5, -25, 0, 40), Position = UDim2.new(0, 20, 0, 135), BackgroundColor3 = Theme.Element,
		Text = "VALIDATE", TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 14, Parent = KeyWindow
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = CheckBtn})
	local CheckStroke = Create("UIStroke", {Color = Theme.Stroke, Parent = CheckBtn})

	local GetKeyBtn = Create("TextButton", {
		Size = UDim2.new(0.5, -25, 0, 40), Position = UDim2.new(0.5, 5, 0, 135), BackgroundColor3 = Theme.Element,
		Text = "GET KEY", TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 14, Parent = KeyWindow
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = GetKeyBtn})
	Create("UIStroke", {Color = Theme.Stroke, Parent = GetKeyBtn})

	GetKeyBtn.MouseButton1Click:Connect(function()
		setclipboard(link)
		GetKeyBtn.Text = "COPIED TO CLIPBOARD"
		task.wait(1.5)
		GetKeyBtn.Text = "GET KEY"
	end)

	CheckBtn.MouseButton1Click:Connect(function()
		if KeyBox.Text == correctKey then
			Tween(CheckStroke, {Color = Theme.Success}, 0.2)
			CheckBtn.Text = "SUCCESS"
			CheckBtn.TextColor3 = Theme.Success
			task.wait(0.8)
			Tween(KeyWindow, {Size = UDim2.new(0, 400, 0, 0), BackgroundTransparency = 1}, 0.4).Completed:Wait()
			KeyWindow:Destroy()
			config.Callback()
		else
			Tween(CheckStroke, {Color = Theme.Error}, 0.2)
			CheckBtn.Text = "INVALID"
			CheckBtn.TextColor3 = Theme.Error
			task.wait(1)
			Tween(CheckStroke, {Color = Theme.Stroke}, 0.2)
			CheckBtn.Text = "VALIDATE"
			CheckBtn.TextColor3 = Theme.Text
		end
	end)
end

