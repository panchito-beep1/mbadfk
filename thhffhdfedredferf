local Theme = {
	Background = Color3.fromRGB(18, 15, 24),
	Panel = Color3.fromRGB(28, 24, 38),
	Element = Color3.fromRGB(38, 33, 50),
	Accent = Color3.fromRGB(145, 128, 230),
	AccentHover = Color3.fromRGB(165, 148, 250),
	Text = Color3.fromRGB(245, 240, 255),
	SubText = Color3.fromRGB(160, 150, 180),
	Stroke = Color3.fromRGB(65, 55, 85),
	Success = Color3.fromRGB(100, 220, 140),
	Error = Color3.fromRGB(240, 90, 90)
}

-- Utility: Create UI Instances quickly
local function Create(className, properties)
	local inst = Instance.new(className)
	for k, v in pairs(properties) do
		inst[k] = v
	end
	return inst
end

-- Utility: Smooth Tweening
local function Tween(instance, properties, duration)
	local tw = TweenService:Create(instance, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), properties)
	tw:Play()
	return tw
end

-- Utility: Make Draggable
local function MakeDraggable(dragArea, moveTarget)
	local dragging, dragInput, dragStart, startPos
	dragArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = moveTarget.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	dragArea.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			Tween(moveTarget, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.1)
		end
	end)
end

