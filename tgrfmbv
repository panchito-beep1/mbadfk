    local AccentLine = Instance.new("Frame", WatermarkBg)
    AccentLine.BackgroundColor3 = Colors.Accent
    AccentLine.Size = UDim2.new(1, 0, 0, 2)
    AccentLine.BorderSizePixel = 0

    local WMLabel = Instance.new("TextLabel", WatermarkBg)
    WMLabel.BackgroundTransparency = 1
    WMLabel.Position = UDim2.new(0, 10, 0, 0)
    WMLabel.Size = UDim2.new(1, -20, 1, 0)
    WMLabel.Font = Enum.Font.GothamSemibold
    WMLabel.TextColor3 = Colors.Text
    WMLabel.TextSize = 13
    WMLabel.TextXAlignment = Enum.TextXAlignment.Left

    local fps = 0
    Library:TrackConnection("FPSCounter", RunService.RenderStepped:Connect(function(dt) fps = math.floor(1 / dt) end))

    Library:TrackConnection("WatermarkLoop", RunService.Heartbeat:Connect(function()
        if not self.LastWMUpdate or tick() - self.LastWMUpdate >= 1 then
            self.LastWMUpdate = tick()
            local timeStr = os.date("%I:%M %p")
            WMLabel.Text = string.format("%s | FPS: %d | %s", text, fps, timeStr)
            TweenService:Create(WatermarkBg, Tweens.Fast, {Size = UDim2.new(0, WMLabel.TextBounds.X + 20, 0, 30)}):Play()
        end
    end))
end

