function Library:TrackConnection(name, connection)
    if self.Connections[name] then self.Connections[name]:Disconnect() end
    self.Connections[name] = connection
    return connection
end

function Library:Unload()
    for _, conn in pairs(self.Connections) do conn:Disconnect() end
    table.clear(self.Connections)
    if self.Instances["ScreenGui"] then self.Instances["ScreenGui"]:Destroy() end
end

