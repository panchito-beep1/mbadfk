        function Tab:CreateSlider(text, min, max, default, callback)
            local SliderBg = Instance.new("Frame", Page)
            SliderBg.BackgroundColor3 = Colors.ElementBg
            SliderBg.Size = UDim2.new(1, 0, 0, 55)
            Instance.new("UICorner", SliderBg).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", SliderBg).Color = Colors.Stroke

            local TitleLabel = Instance.new("TextLabel", SliderBg)
            TitleLabel.BackgroundTransparency = 1
            TitleLabel.Position = UDim2.new(0, 15, 0, 5)
            TitleLabel.Size = UDim2.new(0.5, 0, 0, 25)
            TitleLabel.Font = Enum.Font.GothamSemibold
            TitleLabel.Text = text
            TitleLabel.TextColor3 = Colors.Text
            TitleLabel.TextSize = 14
            TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

            local ValueInput = Instance.new("TextBox", SliderBg)
            ValueInput.BackgroundTransparency = 1
            ValueInput.Position = UDim2.new(0.5, -15, 0, 5)
            ValueInput.Size = UDim2.new(0.5, 0, 0, 25)
            ValueInput.Font = Enum.Font.Gotham
            ValueInput.Text = tostring(default)
            ValueInput.TextColor3 = Colors.Accent
            ValueInput.TextSize = 14
            ValueInput.TextXAlignment = Enum.TextXAlignment.Right

            local Track = Instance.new("Frame", SliderBg)
            Track.BackgroundColor3 = Colors.TabOff
            Track.Position = UDim2.new(0, 15, 0, 35)
            Track.Size = UDim2.new(1, -30, 0, 6)
            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame", Track)
            Fill.BackgroundColor3 = Colors.Accent
            Fill.Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0)
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local dragging = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                TweenService:Create(Fill, Tweens.Fast, {Size = UDim2.new(pos, 0, 1, 0)}):Play()
                ValueInput.Text = tostring(value)
                pcall(callback, value)
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true updateSlider(input) end
            end)
            Library:TrackConnection("SliderDragEnd", UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end))
            Library:TrackConnection("SliderDragMove", UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end
            end))

            ValueInput.FocusLost:Connect(function()
                local num = tonumber(ValueInput.Text)
                if num then
                    num = math.clamp(num, min, max)
                    local pos = (num - min) / (max - min)
                    TweenService:Create(Fill, Tweens.Fast, {Size = UDim2.new(pos, 0, 1, 0)}):Play()
                    ValueInput.Text = tostring(num)
                    pcall(callback, num)
                else
                    ValueInput.Text = tostring(default)
                end
            end)
        end

