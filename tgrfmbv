            Arrow.TextColor3 = Colors.TextDark
            Arrow.TextSize = 14
            Arrow.TextXAlignment = Enum.TextXAlignment.Center

            local OptionContainer = Instance.new("Frame", DropBtn)
            OptionContainer.BackgroundColor3 = Colors.ElementBg
            OptionContainer.Position = UDim2.new(0, 0, 0, 38)
            OptionContainer.Size = UDim2.new(1, 0, 0, 0)
            OptionContainer.ClipsDescendants = true
            Instance.new("UICorner", OptionContainer).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", OptionContainer).Color = Colors.Stroke

            local SearchBox = Instance.new("TextBox", OptionContainer)
            SearchBox.BackgroundColor3 = Colors.TabOff
            SearchBox.Position = UDim2.new(0, 5, 0, 5)
            SearchBox.Size = UDim2.new(1, -10, 0, 26)
            SearchBox.Font = Enum.Font.Gotham
            SearchBox.PlaceholderText = "Search..."
            SearchBox.Text = ""
            SearchBox.TextColor3 = Colors.Text
            SearchBox.TextSize = 13
            Instance.new("UICorner", SearchBox).CornerRadius = UDim.new(0, 4)

            local ScrollArea = Instance.new("ScrollingFrame", OptionContainer)
            ScrollArea.BackgroundTransparency = 1
            ScrollArea.Position = UDim2.new(0, 0, 0, 36)
            ScrollArea.Size = UDim2.new(1, 0, 1, -36)
            ScrollArea.ScrollBarThickness = 2
            ScrollArea.ScrollBarImageColor3 = Colors.Accent
            ScrollArea.BorderSizePixel = 0

            local OptionList = Instance.new("UIListLayout", ScrollArea)
            OptionList.SortOrder = Enum.SortOrder.LayoutOrder

            local isOpen = false
            local MAX_DISPLAY = 5

            local function populateOptions(filter)
                for _, child in ipairs(ScrollArea:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                local count = 0
                for _, option in ipairs(options) do
                    if filter == "" or string.find(string.lower(option), string.lower(filter)) then
                        count = count + 1
                        local OptionBtn = Instance.new("TextButton", ScrollArea)
                        OptionBtn.BackgroundColor3 = Colors.TabOff
                        OptionBtn.Size = UDim2.new(1, 0, 0, 30)
                        OptionBtn.Font = Enum.Font.Gotham
                        OptionBtn.Text = option
                        OptionBtn.TextColor3 = Colors.TextDark
                        OptionBtn.TextSize = 13
                        OptionBtn.AutoButtonColor = false

                        OptionBtn.MouseEnter:Connect(function() TweenService:Create(OptionBtn, Tweens.Fast, {BackgroundColor3 = Colors.ElementHover}):Play() end)
                        OptionBtn.MouseLeave:Connect(function() TweenService:Create(OptionBtn, Tweens.Fast, {BackgroundColor3 = Colors.TabOff}):Play() end)
                        OptionBtn.MouseButton1Click:Connect(function()
                            Label.Text = text .. " : " .. option
                            isOpen = false
                            TweenService:Create(DropBtn, Tweens.Medium, {Size = UDim2.new(1, 0, 0, 38)}):Play()
                            TweenService:Create(OptionContainer, Tweens.Fast, {Size = UDim2.new(1, 0, 0, 0)}):Play()
                            TweenService:Create(Arrow, Tweens.Fast, {Rotation = 0}):Play()
                            pcall(callback, option)
                        end)
                    end
                end
                ScrollArea.CanvasSize = UDim2.new(0, 0, 0, count * 30)
                return math.min(count, MAX_DISPLAY)
            end

            SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                if isOpen then
                    local visibleCount = populateOptions(SearchBox.Text)
                    local totalHeight = 36 + (visibleCount * 30)
                    TweenService:Create(DropBtn, Tweens.Fast, {Size = UDim2.new(1, 0, 0, 38 + totalHeight)}):Play()
                    TweenService:Create(OptionContainer, Tweens.Fast, {Size = UDim2.new(1, 0, 0, totalHeight)}):Play()
                end
            end)

            DropBtn.MouseButton1Click:Connect(function()
                if SearchBox:IsFocused() then return end
                isOpen = not isOpen
                local visibleCount = populateOptions("")
                SearchBox.Text = ""
                local totalHeight = isOpen and (36 + (visibleCount * 30)) or 0
                TweenService:Create(DropBtn, Tweens.Medium, {Size = UDim2.new(1, 0, 0, 38 + totalHeight)}):Play()
                TweenService:Create(OptionContainer, Tweens.Medium, {Size = UDim2.new(1, 0, 0, totalHeight)}):Play()
                TweenService:Create(Arrow, Tweens.Fast, {Rotation = isOpen and 180 or 0}):Play()
            end)
        end

        function Tab:CreateColorPicker(text, defaultColor, callback)
            defaultColor = defaultColor or Color3.fromRGB(255, 255, 255)
            local open = false

            local PickerBtn = Instance.new("TextButton", Page)
            PickerBtn.BackgroundColor3 = Colors.ElementBg
            PickerBtn.Size = UDim2.new(1, 0, 0, 38)
            PickerBtn.Text = ""
            PickerBtn.AutoButtonColor = false
            PickerBtn.ClipsDescendants = true
            Instance.new("UICorner", PickerBtn).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", PickerBtn).Color = Colors.Stroke

            local Label = Instance.new("TextLabel", PickerBtn)
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 15, 0, 0)
            Label.Size = UDim2.new(1, -60, 0, 38)
            Label.Font = Enum.Font.GothamSemibold
            Label.Text = text
            Label.TextColor3 = Colors.Text
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local ColorPreview = Instance.new("Frame", PickerBtn)
            ColorPreview.BackgroundColor3 = defaultColor
            ColorPreview.Position = UDim2.new(1, -40, 0.5, -10)
            ColorPreview.Size = UDim2.new(0, 25, 0, 20)
            Instance.new("UICorner", ColorPreview).CornerRadius = UDim.new(0, 4)
            Instance.new("UIStroke", ColorPreview).Color = Colors.Stroke

            local Container = Instance.new("Frame", PickerBtn)
            Container.BackgroundColor3 = Colors.ElementBg
            Container.Position = UDim2.new(0, 0, 0, 42)
            Container.Size = UDim2.new(1, 0, 0, 0)
            Container.ClipsDescendants = true
            Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", Container).Color = Colors.Stroke

            -- The Hue Spectrum Bar
            local HueBar = Instance.new("Frame", Container)
            HueBar.Position = UDim2.new(0, 15, 0, 10)
            HueBar.Size = UDim2.new(1, -85, 0, 15)
            Instance.new("UICorner", HueBar).CornerRadius = UDim.new(0, 4)
            
            local UIGradient = Instance.new("UIGradient", HueBar)
            UIGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.166, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.666, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
            })

            local HueSelector = Instance.new("Frame", HueBar)
            HueSelector.BackgroundColor3 = Colors.Text
            HueSelector.Size = UDim2.new(0, 4, 1, 4)
            HueSelector.Position = UDim2.new(0, 0, 0, -2)
            Instance.new("UICorner", HueSelector).CornerRadius = UDim.new(1, 0)

            local HexInput = Instance.new("TextBox", Container)
            HexInput.BackgroundColor3 = Colors.TabOff
            HexInput.Position = UDim2.new(1, -60, 0, 7)
            HexInput.Size = UDim2.new(0, 50, 0, 20)
            HexInput.Font = Enum.Font.Gotham
            HexInput.Text = defaultColor:ToHex()
            HexInput.TextColor3 = Colors.Text
            HexInput.TextSize = 12
            Instance.new("UICorner", HexInput).CornerRadius = UDim.new(0, 4)

            local function updateColor(hueVal)
                local color = Color3.fromHSV(math.clamp(hueVal, 0, 1), 1, 1)
                ColorPreview.BackgroundColor3 = color
                HexInput.Text = color:ToHex()
                pcall(callback, color)
            end

            local dragging = false
            HueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    local pct = math.clamp((input.Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1)
                    TweenService:Create(HueSelector, Tweens.Fast, {Position = UDim2.new(pct, -2, 0, -2)}):Play()
                    updateColor(pct)
                end
            end)
            Library:TrackConnection("ColorDragEnd", UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end))
            Library:TrackConnection("ColorDragMove", UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local pct = math.clamp((input.Position.X - HueBar.AbsolutePosition.X) / HueBar.AbsoluteSize.X, 0, 1)
                    TweenService:Create(HueSelector, Tweens.Fast, {Position = UDim2.new(pct, -2, 0, -2)}):Play()
                    updateColor(pct)
                end
            end))

            HexInput.FocusLost:Connect(function()
                pcall(function()
                    local newColor = Color3.fromHex(HexInput.Text)
                    ColorPreview.BackgroundColor3 = newColor
                    pcall(callback, newColor)
                end)
            end)

            PickerBtn.MouseButton1Click:Connect(function()
                if HexInput:IsFocused() then return end
                open = not open
                TweenService:Create(Container, Tweens.Medium, {Size = UDim2.new(1, 0, 0, open and 35 or 0)}):Play()
                TweenService:Create(PickerBtn, Tweens.Medium, {Size = UDim2.new(1, 0, 0, open and 80 or 38)}):Play()
            end)
        end

        return Tab
    end

    function Window:SetScale(scaleValue)
        local currentScale = MainFrame:FindFirstChildOfClass("UIScale")
        if not currentScale then
            currentScale = Instance.new("UIScale", MainFrame)
        end
        TweenService:Create(currentScale, Tweens.Medium, {Scale = scaleValue}):Play()
    end

    return Window
end

return Library
