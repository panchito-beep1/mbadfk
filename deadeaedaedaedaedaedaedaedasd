local Components = {}

function Components.Button(parent, title, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.4, 0, 0, 35)
	btn.BackgroundColor3 = Config.AccentColor
	btn.Text = title
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.TextSize = 14
	btn.Font = Enum.Font.GothamBold
	btn.Parent = parent
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn
	
	btn.MouseButton1Click:Connect(callback)
	
	-- Ripple Effect Logic
	local function Ripple(x, y)
		local ripple = Instance.new("Frame")
		ripple.Size = UDim2.new(0, 10, 0, 10)
		ripple.Position = UDim2.new(0, x - 5, 0, y - 5)
		ripple.BackgroundColor3 = Color3.new(1, 1, 1)
		ripple.BackgroundTransparency = 0.7
		ripple.Parent = btn
		local rC = Instance.new("UICorner")
		rC.CornerRadius = UDim.new(1, 0)
		rC.Parent = ripple
		
		local tw = TweenService:Create(ripple, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 200, 0, 200), BackgroundTransparency = 1})
		tw:Play()
		tw.Completed:Connect(function() ripple:Destroy() end)
	end
	
	btn.MouseButton1Down:Connect(function(input) Ripple(input.Position.X, input.Position.Y) end)
	
	return btn
end

function Components.Toggle(parent, title, defaultState)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 35)
	container.BackgroundTransparency = 1
	container.Parent = parent
	
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.7, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = title
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.TextSize = 14
	lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = container
	
	local switchBg = Instance.new("Frame")
	switchBg.Size = UDim2.new(0, 45, 0, 25)
	switchBg.Position = UDim2.new(0.8, 0, 0.15, 0)
	switchBg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	switchBg.Parent = container
	local swCorner = Instance.new("UICorner")
	swCorner.CornerRadius = UDim.new(1, 0)
	swCorner.Parent = switchBg
	
	local switchKnob = Instance.new("Frame")
	switchKnob.Size = UDim2.new(0, 20, 0, 20)
	switchKnob.Position = UDim2.new(0, 3, 0, 2.5)
	switchKnob.BackgroundColor3 = Color3.new(1, 1, 1)
	switchKnob.Parent = switchBg
	local skCorner = Instance.new("UICorner")
	skCorner.CornerRadius = UDim.new(1, 0)
	skCorner.Parent = switchKnob
	
	local isOn = defaultState or false
	
	local function updateUI()
		if isOn then
			TweenService:Create(switchKnob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Position = UDim2.new(0, 22, 0, 2.5)}):Play()
			TweenService:Create(switchBg, TweenInfo.new(0.15), {BackgroundColor3 = Config.AccentColor}):Play()
		else
			TweenService:Create(switchKnob, TweenInfo.new(0.15), {Position = UDim2.new(0, 3, 0, 2.5)}):Play()
			TweenService:Create(switchBg, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
		end
	end
	updateUI()
	
	switchBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isOn = not isOn
			updateUI()
		end
	end)
	
	return container
end

function Components.Slider(parent, title, minVal, maxVal, defaultVal)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 40)
	container.BackgroundTransparency = 1
	container.Parent = parent
	
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.5, 0, 0.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = title
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = container

	local valueLbl = Instance.new("TextLabel")
	valueLbl.Size = UDim2.new(0.4, 0, 0.5, 0)
	valueLbl.Position = UDim2.new(0.6, 0, 0, 0)
	valueLbl.BackgroundTransparency = 1
	valueLbl.Text = tostring(defaultVal or 0)
	valueLbl.TextColor3 = Config.AccentColor
	valueLbl.Font = Enum.Font.GothamBold
	valueLbl.TextSize = 14
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.Parent = container
	
	local sliderBg = Instance.new("Frame")
	sliderBg.Size = UDim2.new(1, 0, 0, 6)
	sliderBg.Position = UDim2.new(0, 0, 0.7, 0)
	sliderBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	sliderBg.Parent = container
	local sCorner = Instance.new("UICorner")
	sCorner.CornerRadius = UDim.new(1, 0)
	sCorner.Parent = sliderBg
	
	local sliderFill = Instance.new("Frame")
	sliderFill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
	sliderFill.BackgroundColor3 = Config.AccentColor
	sliderFill.Parent = sliderBg
	local fCorner = Instance.new("UICorner")
	fCorner.CornerRadius = UDim.new(1, 0)
	fCorner.Parent = sliderFill
	
	local thumb = Instance.new("Frame")
	thumb.Size = UDim2.new(0, 15, 0, 15)
	thumb.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 0.5, -7.5)
	thumb.BackgroundColor3 = Color3.new(1, 1, 1)
	thumb.Parent = sliderBg
	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(1, 0)
	tCorner.Parent = thumb
	
	local isDragging = false
	sliderBg.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = true
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isDragging = false
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local posX = input.Position.X
			local absX = sliderBg.AbsolutePosition.X
			local sizeX = sliderBg.AbsoluteSize.X
			
			local normalized = (posX - absX) / sizeX
			if normalized < 0 then normalized = 0 end
			if normalized > 1 then normalized = 1 end
			
			local val = minVal + (maxVal - minVal) * normalized
			valueLbl.Text = string.format("%.2f", val)
			sliderFill.Size = UDim2.new(normalized, 0, 1, 0)
			thumb.Position = UDim2.new(normalized, 0, 0.5, -7.5)
		end
	end)
	
	return container
end

function Components.Checkbox(parent, title)
	local container = Instance.new("Frame")
