	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = container
	
	local isChecked = false
	box.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			isChecked = not isChecked
			if isChecked then
				checkMark.Text = "✓"
				TweenService:Create(box, TweenInfo.new(0.1), {BackgroundColor3 = Config.AccentColor}):Play()
			else
				checkMark.Text = ""
				TweenService:Create(box, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()
			end
		end
	end)
	
	return container
end

function Components.Dropdown(parent, title, items)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, 0, 0, 40)
	container.BackgroundTransparency = 1
	container.Parent = parent
	
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(0.5, 0, 0.5, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = title
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 14
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = container
	
	local display = Instance.new("Frame")
	display.Size = UDim2.new(0.5, 0, 0.5, 0)
	display.Position = UDim2.new(0.5, 0, 0, 0)
	display.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	display.BackgroundTransparency = 0.5
	display.Parent = container
	local dCorner = Instance.new("UICorner")
	dCorner.CornerRadius = UDim.new(0, 5)
	dCorner.Parent = display
	
	local dText = Instance.new("TextLabel")
	dText.Size = UDim2.new(0.9, 0, 1, 0)
	dText.Position = UDim2.new(0.05, 0, 0, 0)
	dText.BackgroundTransparency = 1
	dText.Text = items[1] or "Select..."
	dText.TextColor3 = Color3.new(0.7, 0.7, 0.7)
	dText.TextSize = 13
	dText.Font = Enum.Font.Gotham
	dText.TextXAlignment = Enum.TextXAlignment.Left
	dText.Parent = display
	
	local dropDownMenu = Instance.new("Frame")
	dropDownMenu.Size = UDim2.new(0.5, 0, 0, 0)
	dropDownMenu.Position = UDim2.new(0.5, 0, 1.2, 0)
	dropDownMenu.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	dropDownMenu.BackgroundTransparency = 0.6
	dropDownMenu.Visible = false
	dropDownMenu.Parent = container
	local ddCorner = Instance.new("UICorner")
	ddCorner.CornerRadius = UDim.new(0, 5)
	ddCorner.Parent = dropDownMenu
	
	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, 0, 1, 0)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 2
	list.Parent = dropDownMenu
	
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 2)
	listLayout.Parent = list
	
	local isOpen = false
	
	local function toggleDropdown()
		isOpen = not isOpen
		if isOpen then
			dropDownMenu.Visible = true
			local totalHeight = math.min(#items * 30, 150)
			TweenService:Create(dropDownMenu, TweenInfo.new(0.2), {Size = UDim2.new(0.5, 0, 0, totalHeight)}):Play()
		else
			TweenService:Create(dropDownMenu, TweenInfo.new(0.2), {Size = UDim2.new(0.5, 0, 0, 0)}):Play()
			task.delay(0.2, function() dropDownMenu.Visible = false end)
		end
	end
	
	display.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			toggleDropdown()
		end
	end)
	
	local function selectItem(text)
		dText.Text = text
		toggleDropdown()
	end
	
	for _, item in ipairs(items) do
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, 0, 0, 30)
		row.BackgroundTransparency = 1
		row.Text = item
		row.TextColor3 = Color3.new(0.9, 0.9, 0.9)
		row.TextSize = 12
		row.Font = Enum.Font.Gotham
		row.Parent = list
		
		row.MouseButton1Click:Connect(function() selectItem(item) end)
	end
	
	return container
end

