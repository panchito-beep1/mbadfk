function CreateNotification(title, body, type)
	local color = Config.AccentColor
	if type == "Success" then color = Color3.fromRGB(80, 200, 120)
	elseif type == "Error" then color = Color3.fromRGB(255, 80, 80) end
	
	local n = Instance.new("Frame")
	n.Size = UDim2.new(1, 0, 0, 80)
	n.BackgroundColor3 = Config.DarkBg
	n.BackgroundTransparency = 0.2
	n.Parent = NotifContainer
	local nCorner = Instance.new("UICorner")
	nCorner.CornerRadius = UDim.new(0, 10)
	nCorner.Parent = n
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = 1
	stroke.Parent = n
	
	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(0.9, 0, 0.4, 0)
	titleLbl.Position = UDim2.new(0.05, 0, 0.1, 0)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = title
	titleLbl.TextColor3 = color
	titleLbl.TextSize = 18
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = n
	
	local bodyLbl = Instance.new("TextLabel")
	bodyLbl.Size = UDim2.new(0.9, 0, 0.4, 0)
	bodyLbl.Position = UDim2.new(0.05, 0, 0.5, 0)
	bodyLbl.BackgroundTransparency = 1
	bodyLbl.Text = body
	bodyLbl.TextColor3 = Color3.new(0.8, 0.8, 0.8)
	bodyLbl.TextSize = 14
	bodyLbl.Font = Enum.Font.Gotham
	bodyLbl.TextXAlignment = Enum.TextXAlignment.Left
	bodyLbl.Parent = n
	
	return n
end

function QueueNotification(notifFrame)
	notifFrame.Size = UDim2.new(1, 0, 0, 0)
	TweenService:Create(notifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 0, 80)}):Play()
	task.wait(5)
	TweenService:Create(notifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 0, 0)}):Play()
	task.wait(0.3)
	notifFrame:Destroy()
end

