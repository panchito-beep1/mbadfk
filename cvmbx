function Library:LoadKeySystem(correctKey, callback)
	local KeyWindow = Instance.new("Frame")
	KeyWindow.Size = UDim2.new(0, 350, 0, 150)
	KeyWindow.Position = UDim2.new(0.5, -175, 0.5, -75)
	KeyWindow.BackgroundColor3 = Theme.Background
	KeyWindow.Parent = LuxeUI
	
	local KCorner = Instance.new("UICorner")
	KCorner.CornerRadius = UDim.new(0, 8)
	KCorner.Parent = KeyWindow
	local KStroke = Instance.new("UIStroke")
	KStroke.Color = Theme.Stroke
	KStroke.Parent = KeyWindow

	local Title = Instance.new("TextLabel")
	Title.Size = UDim2.new(1, 0, 0, 40)
	Title.BackgroundTransparency = 1
	Title.Text = "Luxe Authentication"
	Title.TextColor3 = Theme.Accent
	Title.Font = Enum.Font.GothamBold
	Title.TextSize = 16
	Title.Parent = KeyWindow

	local KeyBox = Instance.new("TextBox")
	KeyBox.Size = UDim2.new(1, -40, 0, 35)
	KeyBox.Position = UDim2.new(0, 20, 0, 50)
	KeyBox.BackgroundColor3 = Theme.Panel
	KeyBox.Text = ""
	KeyBox.PlaceholderText = "Enter License Key..."
	KeyBox.TextColor3 = Theme.Text
	KeyBox.Font = Enum.Font.Gotham
	KeyBox.TextSize = 14
	KeyBox.Parent = KeyWindow
	
	local BoxCorner = Instance.new("UICorner")
	BoxCorner.CornerRadius = UDim.new(0, 6)
	BoxCorner.Parent = KeyBox

	local CheckBtn = Instance.new("TextButton")
	CheckBtn.Size = UDim2.new(1, -40, 0, 35)
	CheckBtn.Position = UDim2.new(0, 20, 0, 95)
	CheckBtn.BackgroundColor3 = Theme.Panel
	CheckBtn.Text = "VALIDATE"
	CheckBtn.TextColor3 = Theme.Text
	CheckBtn.Font = Enum.Font.GothamBold
	CheckBtn.TextSize = 14
	CheckBtn.Parent = KeyWindow
	
	local BtnCorner = Instance.new("UICorner")
	BtnCorner.CornerRadius = UDim.new(0, 6)
	BtnCorner.Parent = CheckBtn
	local BtnStroke = Instance.new("UIStroke")
	BtnStroke.Color = Theme.Stroke
	BtnStroke.Parent = CheckBtn

	CheckBtn.MouseButton1Click:Connect(function()
		if KeyBox.Text == correctKey then
			Tween(BtnStroke, {Color = Theme.Success}, 0.2)
			CheckBtn.Text = "SUCCESS"
			CheckBtn.TextColor3 = Theme.Success
			task.wait(0.5)
			KeyWindow:Destroy()
			callback()
		else
			Tween(BtnStroke, {Color = Theme.Error}, 0.2)
			CheckBtn.Text = "INVALID KEY"
			CheckBtn.TextColor3 = Theme.Error
			task.wait(1)
			Tween(BtnStroke, {Color = Theme.Stroke}, 0.2)
			CheckBtn.Text = "VALIDATE"
			CheckBtn.TextColor3 = Theme.Text
		end
	end)
end

