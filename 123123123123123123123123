-- Aero UI Library v3
-- Full-featured, premium-styled Roblox UI library with notifications, watermark, tabs,
-- sections, toggles, buttons, sliders, dropdowns, textboxes, keybinds, color pickers,
-- labels, paragraphs, drag support, animated open/close, and API aliases for showcase scripts.

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local Aero = {}
Aero.__index = Aero

local THEME = {
	Background = Color3.fromRGB(10, 10, 13),
	Window = Color3.fromRGB(17, 17, 21),
	Panel = Color3.fromRGB(20, 20, 25),
	Panel2 = Color3.fromRGB(26, 26, 33),
	Stroke = Color3.fromRGB(54, 54, 65),
	Text = Color3.fromRGB(247, 247, 249),
	SubText = Color3.fromRGB(160, 160, 172),
	Accent = Color3.fromRGB(255, 64, 67),
	Accent2 = Color3.fromRGB(255, 145, 147),
	AccentSoft = Color3.fromRGB(255, 92, 95),
	Good = Color3.fromRGB(77, 219, 138),
	Bad = Color3.fromRGB(255, 90, 90),
}

local function create(className, props)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	return inst
end

local function round(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

local function stroke(parent, transparency, thickness)
	return create("UIStroke", {
		Color = THEME.Stroke,
		Transparency = transparency or 0,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function pad(parent, left, right, top, bottom)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function tween(obj, info, goal)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local function clamp01(n)
	return math.clamp(n, 0, 1)
end

local function softenButton(btn, base, hover, press)
	base = base or btn.BackgroundColor3
	hover = hover or base:Lerp(Color3.new(1, 1, 1), 0.05)
	press = press or base:Lerp(Color3.new(0, 0, 0), 0.08)
	btn.BackgroundColor3 = base
	btn.AutoButtonColor = false

	local scale = btn:FindFirstChildOfClass("UIScale") or create("UIScale", { Scale = 1, Parent = btn })

	btn.MouseEnter:Connect(function()
		tween(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { BackgroundColor3 = hover })
		tween(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.03 })
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { BackgroundColor3 = base })
		tween(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function()
		tween(btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = press })
		tween(scale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.985 })
	end)
	btn.MouseButton1Up:Connect(function()
		tween(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = hover })
		tween(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.03 })
	end)
end

local function revealGroup(group)
	group.Visible = true
	group.GroupTransparency = 1
	tween(group, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { GroupTransparency = 0 })
end

local function hideGroup(group)
	local t = tween(group, TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { GroupTransparency = 1 })
	t.Completed:Connect(function()
		if group and group.Parent then
			group.Visible = false
		end
	end)
end

local function attachGradientMotion(gradient, speed)
	speed = speed or 10
	local start = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if not gradient or not gradient.Parent then
			if conn then conn:Disconnect() end
			return
		end
		gradient.Rotation = ((tick() - start) * speed) % 360
	end)
	return conn
end

function Aero:Destroy()
	for _, conn in ipairs(self._maid or {}) do
		pcall(function() conn:Disconnect() end)
	end
	if self._blur then
		self._blur:Destroy()
	end
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
end

function Aero:_notify(title, content, duration)
	duration = duration or 3
	self._notifications = self._notifications or {}

	local holder = self._notifyHolder
	if not holder then
		holder = create("Frame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -18, 0, 18),
			Size = UDim2.new(0, 320, 1, -36),
			Parent = self.ScreenGui,
		})
		local layout = create("UIListLayout", {
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Parent = holder,
		})
		self._notifyHolder = holder
	end

	local card = create("CanvasGroup", {
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(320, 72),
		GroupTransparency = 1,
		Parent = holder,
	})
	round(card, 14)
	stroke(card, 0.12, 1)

	local gradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 24, 29)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 21)),
		}),
		Rotation = 90,
		Parent = card,
	})

	local accent = create("Frame", {
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(4, 48),
		Parent = card,
	})
	round(accent, 999)
	local accentGrad = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, THEME.Accent),
			ColorSequenceKeypoint.new(1, THEME.Accent2),
		}),
		Rotation = 0,
		Parent = accent,
	})
	attachGradientMotion(accentGrad, 20)

	local titleLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(26, 12),
		Size = UDim2.new(1, -38, 0, 20),
		Font = Enum.Font.GothamBold,
		Text = title or "Notification",
		TextColor3 = THEME.Text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	local contentLabel = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(26, 32),
		Size = UDim2.new(1, -38, 0, 26),
		Font = Enum.Font.Gotham,
		Text = content or "",
		TextColor3 = THEME.SubText,
		TextSize = 12,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})

	card.Position = UDim2.new(1, 340, 0, 0)
	tween(card, TweenInfo.new(0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0),
		GroupTransparency = 0,
	})

	task.delay(duration, function()
		if card and card.Parent then
			local out = tween(card, TweenInfo.new(0.24, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
				Position = UDim2.new(1, 340, 0, 0),
				GroupTransparency = 1,
			})
			out.Completed:Connect(function()
				if card then card:Destroy() end
			end)
		end
	end)

	return card
end

function Aero:_buildCore(config)
	self.Config = config or {}
	self._theme = table.clone(THEME)

	self.ScreenGui = create("ScreenGui", {
		Name = config.Name or "AeroUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = config.Parent or PlayerGui,
	})

	self._blur = create("BlurEffect", {
		Name = "AeroBlur",
		Size = 0,
		Parent = Lighting,
	})

	self.Backdrop = create("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = self.ScreenGui,
	})

	self.WindowScale = create("UIScale", {
		Scale = 0.96,
		Parent = self.ScreenGui,
	})

	self.Window = create("CanvasGroup", {
		Name = "Window",
		BackgroundColor3 = self._theme.Window,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = config.Position or UDim2.fromScale(0.5, 0.5),
		Size = config.Size or UDim2.fromOffset(780, 480),
		GroupTransparency = 1,
		Parent = self.ScreenGui,
	})
	round(self.Window, 16)
	stroke(self.Window, 0.08, 1)

	local windowGradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 24, 30)),
			ColorSequenceKeypoint.new(1, self._theme.Window),
		}),
		Rotation = 90,
		Parent = self.Window,
	})

	local topStrip = create("Frame", {
		BackgroundColor3 = self._theme.Accent,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 2),
		Parent = self.Window,
	})
	local stripGradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, self._theme.Accent),
			ColorSequenceKeypoint.new(1, self._theme.Accent2),
		}),
		Rotation = 0,
		Parent = topStrip,
	})
	attachGradientMotion(stripGradient, 18)

	self.Grip = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = self.Window,
	})

	create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(20, 10),
		Size = UDim2.new(1, -140, 0, 22),
		Font = Enum.Font.GothamBlack,
		Text = config.Title or "AERO",
		TextColor3 = Color3.fromRGB(0, 0, 0),
		TextTransparency = 0.72,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.Window,
	})

	self.Title = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(19, 9),
		Size = UDim2.new(1, -140, 0, 22),
		Font = Enum.Font.GothamBlack,
		Text = config.Title or "AERO",
		TextColor3 = self._theme.Text,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.Window,
	})

	self.SubTitle = create("TextLabel", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(19, 29),
		Size = UDim2.new(1, -140, 0, 14),
		Font = Enum.Font.Gotham,
		Text = config.SubTitle or "Premium motion, sharper polish",
		TextColor3 = self._theme.SubText,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.Window,
	})

	self.Close = create("TextButton", {
		BackgroundColor3 = Color3.fromRGB(30, 30, 36),
		BorderSizePixel = 0,
		Position = UDim2.new(1, -46, 0, 9),
		Size = UDim2.fromOffset(28, 28),
		Font = Enum.Font.GothamBold,
		Text = "✕",
		TextColor3 = self._theme.SubText,
		TextSize = 14,
		Parent = self.Window,
	})
	round(self.Close, 9)
	stroke(self.Close, 0.25, 1)
	softenButton(self.Close, self.Close.BackgroundColor3, Color3.fromRGB(44, 44, 52), Color3.fromRGB(24, 24, 28))

	self.Sidebar = create("Frame", {
		BackgroundColor3 = self._theme.Panel,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 54),
		Size = UDim2.new(0, 178, 1, -70),
		Parent = self.Window,
	})
	round(self.Sidebar, 14)
	stroke(self.Sidebar, 0.12, 1)
	pad(self.Sidebar, 10, 10, 10, 10)

	self.TabList = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = self._theme.Accent,
		Parent = self.Sidebar,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = self.TabList,
	})

	self.Pages = create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(206, 54),
		Size = UDim2.new(1, -222, 1, -70),
		Parent = self.Window,
	})

	self._dragging = false
	self._dragStart = nil
	self._startPos = nil

	self._maid[#self._maid + 1] = self.Grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self._dragging = true
			self._dragStart = input.Position
			self._startPos = self.Window.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					self._dragging = false
				end
			end)
		end
	end)

	self._maid[#self._maid + 1] = UserInputService.InputChanged:Connect(function(input)
		if self._dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - self._dragStart
			self.Window.Position = UDim2.new(
				self._startPos.X.Scale,
				self._startPos.X.Offset + delta.X,
				self._startPos.Y.Scale,
				self._startPos.Y.Offset + delta.Y
			)
		end
	end)

	self._maid[#self._maid + 1] = self.Close.MouseButton1Click:Connect(function()
		self:Destroy()
	end)

	self._maid[#self._maid + 1] = task.delay(0.06, function()
		if self._blur then self._blur.Size = 18 end
		tween(self.WindowScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
		tween(self.Window, TweenInfo.new(0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { GroupTransparency = 0 })
		tween(self.Backdrop, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.45 })
	end)

	function self:_setTabVisual(tab)
		for _, t in ipairs(self._tabs) do
			local active = (t == tab)
			tween(t.Button, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				BackgroundColor3 = active and self._theme.Accent or self._theme.Panel2,
				TextColor3 = active and Color3.new(1, 1, 1) or self._theme.Text,
			})
			tween(t.Indicator, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				BackgroundTransparency = active and 0 or 1,
			})
		end
	end

	function self:Notify(opts)
		opts = opts or {}
		return self:_notify(opts.Title or "Notification", opts.Content or "", opts.Duration or 3)
	end

	function self:CreateWatermark(text)
		if self._watermark then self._watermark:Destroy() end
		local wm = create("CanvasGroup", {
			BackgroundColor3 = self._theme.Panel,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(18, 18),
			Size = UDim2.fromOffset(220, 36),
			GroupTransparency = 1,
			Parent = self.ScreenGui,
		})
		round(wm, 12)
		stroke(wm, 0.12, 1)

		create("TextLabel", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Font = Enum.Font.GothamSemibold,
			Text = text or "AERO",
			TextColor3 = self._theme.Text,
			TextSize = 13,
			Parent = wm,
		})

		self._watermark = wm
		tween(wm, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { GroupTransparency = 0 })
		return wm
	end

	function self:Toggle()
		if self.Window.Visible then
			self:Hide()
		else
			self:Show()
		end
	end

	function self:Show()
		self.ScreenGui.Enabled = true
		self.Window.Visible = true
		self._blur.Size = 18
		revealGroup(self.Window)
		tween(self.Backdrop, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.45 })
		tween(self.WindowScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	end

	function self:Hide()
		hideGroup(self.Window)
		tween(self.Backdrop, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
		tween(self.WindowScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.96 })
		self._blur.Size = 0
	end

	function self:SetTheme(theme)
		for k, v in pairs(theme or {}) do
			if self._theme[k] ~= nil then
				self._theme[k] = v
			end
		end
	end

	function self:CreateTab(name)
		local tab = {}
		tab.Name = name or "Tab"
		tab.Sections = {}
		tab._window = self

		tab.Button = create("TextButton", {
			BackgroundColor3 = self._theme.Panel2,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 36),
			Font = Enum.Font.GothamSemibold,
			Text = tab.Name,
			TextColor3 = self._theme.Text,
			TextSize = 14,
			AutoButtonColor = false,
			Parent = self.TabList,
		})
		round(tab.Button, 11)
		stroke(tab.Button, 0.2, 1)
		softenButton(tab.Button, tab.Button.BackgroundColor3, Color3.fromRGB(33, 33, 40), Color3.fromRGB(24, 24, 28))

		tab.Indicator = create("Frame", {
			BackgroundColor3 = self._theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 8, 1, -4),
			Size = UDim2.new(1, -16, 0, 2),
			Parent = tab.Button,
		})
	round(tab.Indicator, 999)

		tab.Page = create("CanvasGroup", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Visible = false,
			GroupTransparency = 1,
			Parent = self.Pages,
		})
		create("UIListLayout", {
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = tab.Page,
		})
		pad(tab.Page, 2, 4, 2, 2)

		local columns = create("Frame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = tab.Page,
		})
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = columns,
		})

		function tab:SetActive()
			if self._window._activeTab and self._window._activeTab ~= tab then
				hideGroup(self._window._activeTab.Page)
			end
			self._window._activeTab = tab
			tab.Page.Visible = true
			revealGroup(tab.Page)
			self._window:_setTabVisual(tab)
		end

		tab.Button.MouseButton1Click:Connect(function()
			tab:SetActive()
		end)

		function tab:CreateSection(sectionTitle, sectionDesc)
			local section = {}
			section._tab = tab
			section.Elements = {}

			section.Holder = create("Frame", {
				BackgroundColor3 = self._window._theme.Panel,
				BorderSizePixel = 0,
				Size = UDim2.new(0.5, -6, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = columns,
			})
			round(section.Holder, 14)
			stroke(section.Holder, 0.12, 1)
			pad(section.Holder, 14, 14, 14, 14)

			create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(25, 25, 31)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 24)),
				}),
				Rotation = 90,
				Parent = section.Holder,
			})

			create("UIListLayout", {
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = section.Holder,
			})

			create("TextLabel", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 20),
				Font = Enum.Font.GothamBold,
				Text = sectionTitle or "Section",
				TextColor3 = self._window._theme.Text,
				TextSize = 16,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = section.Holder,
			})

			if sectionDesc and sectionDesc ~= "" then
				create("TextLabel", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 16),
					Font = Enum.Font.Gotham,
					Text = sectionDesc,
					TextColor3 = self._window._theme.SubText,
					TextSize = 12,
					TextWrapped = true,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = section.Holder,
				})
			end

			local function row(height)
				return create("Frame", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, height),
					Parent = section.Holder,
				})
			end

			function section:AddLabel(text, subText)
				local r = row(subText and 38 or 22)
				create("TextLabel", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 18),
					Font = Enum.Font.GothamSemibold,
					Text = text or "Label",
					TextColor3 = self._window._theme.Text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = r,
				})
				if subText then
					create("TextLabel", {
						BackgroundTransparency = 1,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(0, 18),
						Size = UDim2.new(1, 0, 0, 14),
						Font = Enum.Font.Gotham,
						Text = subText,
						TextColor3 = self._window._theme.SubText,
						TextSize = 12,
						TextXAlignment = Enum.TextXAlignment.Left,
						Parent = r,
					})
				end
			end

			function section:AddParagraph(opts)
