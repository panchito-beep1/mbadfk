			function section:AddButton(opts)
				opts = opts or {}
				local r = row(40)
				local btn = create("TextButton", {
					BackgroundColor3 = self._window._theme.Accent,
					BorderSizePixel = 0,
					Size = UDim2.fromScale(1, 1),
					Font = Enum.Font.GothamSemibold,
					Text = opts.Name or opts.Text or "Button",
					TextColor3 = Color3.new(1, 1, 1),
					TextSize = 14,
					AutoButtonColor = false,
					Parent = r,
				})
				round(btn, 12)
				stroke(btn, 0.18, 1)
				softenButton(btn, self._window._theme.Accent, self._window._theme.Accent2, self._window._theme.AccentSoft)

				local sheen = create("Frame", {
					BackgroundTransparency = 0.68,
					BorderSizePixel = 0,
					Rotation = 12,
					Position = UDim2.new(-0.4, 0, -0.4, 0),
					Size = UDim2.new(0.35, 0, 1.8, 0),
					Parent = btn,
				})
				create("UIGradient", {
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(0.5, 0.72),
						NumberSequenceKeypoint.new(1, 1),
					}),
					Rotation = 0,
					Parent = sheen,
				})

				btn.MouseEnter:Connect(function()
					tween(sheen, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Position = UDim2.new(1.1, 0, -0.4, 0) })
				end)
				btn.MouseButton1Click:Connect(function()
					if opts.Callback then opts.Callback() end
				end)
				return btn
			end

			function section:AddToggle(opts)
				opts = opts or {}
				local state = not not opts.Default
				local r = row(36)
				local box = create("Frame", {
					BackgroundColor3 = state and self._window._theme.Accent or Color3.fromRGB(18, 18, 22),
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(0, 6),
					Size = UDim2.fromOffset(24, 24),
					Parent = r,
				})
				round(box, 7)
				stroke(box, 0.25, 1)
				local tick = create("TextLabel", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.fromScale(1, 1),
					Font = Enum.Font.GothamBold,
					Text = "✓",
					TextTransparency = state and 0 or 1,
					TextColor3 = Color3.new(1, 1, 1),
					TextSize = 14,
					Parent = box,
				})
				local label = create("TextLabel", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(34, 0),
					Size = UDim2.new(1, -34, 1, 0),
					Font = Enum.Font.GothamSemibold,
					Text = opts.Name or opts.Text or "Toggle",
					TextColor3 = self._window._theme.Text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = r,
				})
				local line = create("Frame", {
					BackgroundColor3 = self._window._theme.Accent,
					BackgroundTransparency = state and 0 or 1,
					BorderSizePixel = 0,
					Position = UDim2.new(0, 0, 1, -2),
					Size = UDim2.new(1, 0, 0, 2),
					Parent = box,
				})
				round(line, 999)
				local function refresh()
					tween(box, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { BackgroundColor3 = state and self._window._theme.Accent or Color3.fromRGB(18, 18, 22) })
					tween(tick, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = state and 0 or 1 })
					tween(line, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = state and 0 or 1 })
				end
				box.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						state = not state
						refresh()
						if opts.Callback then opts.Callback(state) end
					end
				end)
				refresh()
				return {
					Set = function(_, value) state = not not value refresh() end,
					Get = function() return state end,
				}
			end

			function section:AddSlider(opts)
				opts = opts or {}
				local min = opts.Min or 0
				local max = opts.Max or 100
				local value = math.clamp(opts.Default or min, min, max)
				local r = create("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 56), Parent = section.Holder })
				create("TextLabel", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Size = UDim2.new(1, -72, 0, 18),
					Font = Enum.Font.GothamSemibold,
					Text = opts.Name or opts.Text or "Slider",
					TextColor3 = self._window._theme.Text,
					TextSize = 14,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = r,
				})
				local valueLabel = create("TextLabel", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Position = UDim2.new(1, -72, 0, 0),
					Size = UDim2.fromOffset(72, 18),
					Font = Enum.Font.Gotham,
					Text = tostring(value),
					TextColor3 = self._window._theme.SubText,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Right,
					Parent = r,
				})
				local bar = create("Frame", { BackgroundColor3 = Color3.fromRGB(30, 30, 37), BorderSizePixel = 0, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 10), Parent = r })
				round(bar, 999)
				stroke(bar, 0.4, 1)
				local fill = create("Frame", { BackgroundColor3 = self._window._theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale((value - min) / (max - min), 1), Parent = bar })
				round(fill, 999)
				local glow = create("Frame", {
					BackgroundColor3 = self._window._theme.Accent,
					BackgroundTransparency = 0.72,
					BorderSizePixel = 0,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
					Size = UDim2.fromOffset(28, 28),
					Parent = bar,
				})
				round(glow, 999)
				local knob = create("TextButton", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0), Size = UDim2.fromOffset(14, 14), Text = "", Parent = bar })
				round(knob, 999)
				stroke(knob, 0.15, 1)
				local dragging = false
				local function setValue(v)
					value = math.clamp(math.floor(v + 0.5), min, max)
					local alpha = (value - min) / (max - min)
					fill.Size = UDim2.new(alpha, 0, 1, 0)
					knob.Position = UDim2.new(alpha, 0, 0.5, 0)
					glow.Position = UDim2.new(alpha, 0, 0.5, 0)
					valueLabel.Text = tostring(value) .. (opts.Suffix or "")
					if opts.Callback then opts.Callback(value) end
				end
				local function updateFromInput(input)
					local pct = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
					setValue(min + ((max - min) * clamp01(pct)))
				end
				bar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						updateFromInput(input)
					end
				end)
				bar.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)
				table.insert(self._window._maid, UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						updateFromInput(input)
					end
				end))
				setValue(value)
				return { Set = setValue, Get = function() return value end }
			end

			function section:AddDropdown(opts)
				opts = opts or {}
				local items = opts.Options or opts.Items or {}
				local selected = opts.Default or items[1]
				local expanded = false
				local r = create("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 40), AutomaticSize = Enum.AutomaticSize.Y, Parent = section.Holder })
				local btn = create("TextButton", { BackgroundColor3 = self._window._theme.Panel2, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 40), Font = Enum.Font.GothamSemibold, Text = "", AutoButtonColor = false, Parent = r })
				round(btn, 12)
				stroke(btn, 0.22, 1)
				softenButton(btn, self._window._theme.Panel2, Color3.fromRGB(32, 32, 39), Color3.fromRGB(22, 22, 27))
				create("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -40, 1, 0), Font = Enum.Font.GothamSemibold, Text = opts.Name or opts.Text or "Dropdown", TextColor3 = self._window._theme.Text, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = btn })
				local current = create("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(1, -168, 0, 0), Size = UDim2.fromOffset(130, 40), Font = Enum.Font.Gotham, Text = selected and tostring(selected) or "Select", TextColor3 = self._window._theme.SubText, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, Parent = btn })
				local arrow = create("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(1, -26, 0, 0), Size = UDim2.fromOffset(14, 40), Font = Enum.Font.GothamBold, Text = "⌄", TextColor3 = self._window._theme.SubText, TextSize = 16, Parent = btn })
				local listHolder = create("Frame", { BackgroundColor3 = self._window._theme.Panel2, BorderSizePixel = 0, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, 0), Parent = r })
				round(listHolder, 12)
				stroke(listHolder, 0.25, 1)
				local list = create("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = self._window._theme.Accent, Visible = false, Parent = listHolder })
				pad(list, 8, 8, 8, 8)
				create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

				local function refreshHeight()
					local count = #items
					local h = math.min(8 + (count * 34) + math.max(0, count - 1) * 6, 220)
					listHolder.Visible = expanded
					list.Visible = expanded
					arrow.Text = expanded and "⌃" or "⌄"
					tween(listHolder, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, expanded and h or 0) })
				end

				local function selectItem(item)
					selected = item
					current.Text = tostring(item)
					if opts.Callback then opts.Callback(item) end
				end

				btn.MouseButton1Click:Connect(function()
					expanded = not expanded
					refreshHeight()
				end)

				local function rebuild(listItems)
					for _, child in ipairs(list:GetChildren()) do
						if child:IsA("TextButton") then child:Destroy() end
					end
					for _, item in ipairs(listItems) do
						local opt = create("TextButton", { BackgroundColor3 = Color3.fromRGB(30, 30, 36), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 30), Font = Enum.Font.Gotham, Text = tostring(item), TextColor3 = self._window._theme.Text, TextSize = 13, AutoButtonColor = false, Parent = list })
						round(opt, 8)
						softenButton(opt, Color3.fromRGB(30, 30, 36), Color3.fromRGB(38, 38, 45), Color3.fromRGB(24, 24, 28))
						opt.MouseButton1Click:Connect(function()
							selectItem(item)
							expanded = false
							refreshHeight()
						end)
					end
			end

				rebuild(items)
				refreshHeight()
				if selected then selectItem(selected) end
				return { Set = selectItem, Get = function() return selected end, Refresh = function(newItems) items = newItems or {} rebuild(items) refreshHeight() end }
			end

			function section:AddTextbox(opts)
				opts = opts or {}
				local r = row(40)
				create("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamSemibold, Text = opts.Name or opts.Text or "Textbox", TextColor3 = self._window._theme.Text, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
				local box = create("TextBox", {
					BackgroundColor3 = self._window._theme.Panel2,
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(0, 20),
					Size = UDim2.new(1, 0, 0, 18),
					Font = Enum.Font.Gotham,
					PlaceholderText = opts.Placeholder or "Type here...",
					Text = "",
					TextColor3 = self._window._theme.Text,
					PlaceholderColor3 = self._window._theme.SubText,
					TextSize = 13,
					ClearTextOnFocus = false,
					Parent = r,
				})
				round(box, 8)
				stroke(box, 0.25, 1)
				box.FocusLost:Connect(function(enterPressed)
					if opts.Callback then opts.Callback(box.Text, enterPressed) end
				end)
				return box
			end

			function section:AddKeybind(opts)
				opts = opts or {}
				local key = opts.Default or Enum.KeyCode.Unknown
				local listening = false
				local r = row(36)
				create("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -80, 1, 0), Font = Enum.Font.GothamSemibold, Text = opts.Name or opts.Text or "Keybind", TextColor3 = self._window._theme.Text, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
				local btn = create("TextButton", { BackgroundColor3 = self._window._theme.Panel2, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(74, 26), Font = Enum.Font.GothamSemibold, Text = tostring(key.Name):gsub("Left", "L"):gsub("Right", "R"), TextColor3 = self._window._theme.Text, TextSize = 12, AutoButtonColor = false, Parent = r })
				round(btn, 8)
				stroke(btn, 0.25, 1)
				softenButton(btn, self._window._theme.Panel2, Color3.fromRGB(34, 34, 41), Color3.fromRGB(22, 22, 27))
				btn.MouseButton1Click:Connect(function()
					listening = true
					btn.Text = "..."
				end)
				local conn
				conn = UserInputService.InputBegan:Connect(function(input, gp)
					if gp then return end
					if listening and input.UserInputType == Enum.UserInputType.Keyboard then
						key = input.KeyCode
						btn.Text = tostring(key.Name)
						listening = false
						if opts.Callback then opts.Callback(key) end
					elseif input.KeyCode == key and not listening then
						if opts.Callback then opts.Callback(key) end
					end
				end)
				table.insert(self._window._maid, conn)
				return { Get = function() return key end, Set = function(_, k) key = k btn.Text = tostring(key.Name) end }
			end

			function section:AddColorPicker(opts)
				opts = opts or {}
				local color = opts.Default or self._window._theme.Accent
				local r = row(38)
				create("TextLabel", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -52, 1, 0), Font = Enum.Font.GothamSemibold, Text = opts.Name or opts.Text or "Color Picker", TextColor3 = self._window._theme.Text, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
				local swatch = create("TextButton", { BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(32, 22), Text = "", AutoButtonColor = false, Parent = r })
				round(swatch, 7)
				stroke(swatch, 0.2, 1)
				softenButton(swatch, color, color:Lerp(Color3.new(1, 1, 1), 0.05), color:Lerp(Color3.new(0, 0, 0), 0.08))
				swatch.MouseButton1Click:Connect(function()
					local palette = {
						Color3.fromRGB(255, 64, 67), Color3.fromRGB(90, 170, 255), Color3.fromRGB(145, 82, 255),
						Color3.fromRGB(60, 220, 130), Color3.fromRGB(255, 194, 77), Color3.fromRGB(255, 255, 255)
					}
					color = palette[((table.find(palette, color) or 0) % #palette) + 1]
					swatch.BackgroundColor3 = color
					if opts.Callback then opts.Callback(color) end
				end)
				return { Get = function() return color end, Set = function(_, c) color = c swatch.BackgroundColor3 = c end }
			end

			return section
		end

		table.insert(self._tabs, tab)
		if #self._tabs == 1 then
			tab:SetActive()
		end
		return tab
	end

	return self
end

function Aero:CreateWindow(config)
	return self:_buildCore(config)
end

function Aero.CreateWindow(config)
	return Aero.new():CreateWindow(config)
end

function Aero.new(config)
	local self = setmetatable({}, Aero)
	if config then
		return self:_buildCore(config)
	end
	return self
end

function Aero.Create(config)
	return Aero.new(config)
end

return Aero

--[[
Example usage:

local Aero = require(path.to.Module)
local UI = Aero:CreateWindow({
	Title = "AERO",
	SubTitle = "Premium showcase",
	Size = UDim2.fromOffset(780, 480),
})

UI:CreateWatermark("AERO Premium | Showcase")
UI:Notify({ Title = "Loaded", Content = "Interface ready.", Duration = 4 })

local main = UI:CreateTab("Main")
local sec = main:CreateSection("Premium Features", "A cleaner and richer layout")

sec:AddToggle({ Name = "Enable Glow", Default = true, Callback = function(v) print(v) end })
sec:AddButton({ Name = "Launch", Callback = function() print("clicked") end })
sec:AddSlider({ Name = "Intensity", Min = 0, Max = 100, Default = 45, Suffix = "%", Callback = function(v) print(v) end })
sec:AddDropdown({ Name = "Mode", Options = {"Soft", "Balanced", "Sharp"}, Default = "Balanced", Callback = function(v) print(v) end })
sec:AddTextbox({ Name = "Username", Placeholder = "Type something", Callback = function(v) print(v) end })
sec:AddKeybind({ Name = "Toggle UI", Default = Enum.KeyCode.RightControl, Callback = function() UI:Toggle() end })
sec:AddColorPicker({ Name = "Accent", Default = Color3.fromRGB(255, 64, 67), Callback = function(c) print(c) end })
sec:AddParagraph({ Title = "About", Content = "This is the premium showcase build." })
]]
